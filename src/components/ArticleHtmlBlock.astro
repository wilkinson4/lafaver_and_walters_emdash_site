---
/**
 * htmlBlock renderer for article bodies. WordPress imports keep Kadence
 * button blocks as empty self-closing comments (Kadence renders them in PHP),
 * so rebuild those from their saved attributes; everything else uses EmDash's
 * default renderer.
 */
import { HtmlBlock } from "emdash/ui";

interface Props {
	node: {
		_type: "htmlBlock";
		_key: string;
		html: string;
		originalBlockName?: string;
		originalAttrs?: { text?: unknown; link?: unknown };
	};
}

const { node } = Astro.props;

function safeUrl(value: unknown) {
	if (typeof value !== "string" || !value.trim()) return undefined;
	try {
		const url = new URL(value.trim(), "https://placeholder.invalid");
		return url.protocol === "https:" || url.protocol === "http:" ? url.href : undefined;
	} catch {
		return undefined;
	}
}

const button =
	node.originalBlockName === "kadence/singlebtn" && typeof node.originalAttrs?.text === "string"
		? { text: node.originalAttrs.text, href: safeUrl(node.originalAttrs.link) }
		: undefined;
const external = button?.href && !button.href.startsWith("https://placeholder.invalid");
---

{
	button ? (
		button.href && (
			<p>
				<a
					href={external ? button.href : button.href.replace("https://placeholder.invalid", "")}
					class="btn btn-red no-underline!"
					{...(external ? { target: "_blank", rel: "noopener" } : {})}
				>
					{button.text}
				</a>
			</p>
		)
	) : (
		<HtmlBlock node={node} />
	)
}
