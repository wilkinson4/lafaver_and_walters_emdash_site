---
import { Image } from "emdash/ui";
import TopicNav from "./TopicNav.astro";
import {
  readMinutes,
  topicSlugs,
  topicTotal,
  type getHomeArticles,
} from "../lib/site";

type Props = Omit<Awaited<ReturnType<typeof getHomeArticles>>, "cacheHints">;

const { topics, topic, lead, more } = Astro.props;
// Label an article with its category inside the selected topic, if any.
const inTopic = new Set(topic ? topicSlugs(topic) : []);
const topicOf = (a: NonNullable<typeof lead>) => {
  const cats = a.data.terms?.category ?? [];
  return (cats.find((c) => inTopic.has(c.slug)) ?? cats[0])?.label;
};
---

<div id="home-articles" class="group/swap">
  <TopicNav
    topics={topics}
    active={topic?.slug}
    allLabel="Featured"
    sort={false}
    subtopics={false}
    href={(slug) => (slug ? `/?topic=${slug}#learn` : "/#learn")}
    swap={{
      target: "home-articles",
      src: (slug) =>
        slug
          ? `/partials/home-articles?topic=${slug}`
          : "/partials/home-articles",
    }}
  />
  {lead ? (
    <div
      data-swap-animate
      class="grid gap-10 transition-opacity group-aria-busy/swap:opacity-50 md:grid-cols-[1.25fr_1fr]"
    >
      <a href={`/learn/${lead.id}`} class="flex flex-col bg-white">
        <div class="cover h-85 bg-[#ddd]">
          {lead.data.featured_image && (
            <Image image={lead.data.featured_image} />
          )}
        </div>
        <div class="p-9">
          {topicOf(lead) && (
            <div class="text-sm font-bold tracking-[2px] text-brand uppercase">
              {topicOf(lead)}
            </div>
          )}
          <h3 class="mt-2.5 mb-3.5 font-serif text-[34px] leading-[1.2] font-medium">
            {lead.data.title}
          </h3>
          <p class="mb-5 text-muted">{lead.data.excerpt}</p>
          <div class="flex gap-4.5 text-[15px] text-[#666]">
            <span>{readMinutes(lead.data.content)} min read</span>
            <span>·</span>
            <span class="border-b-2 border-brand pb-0.5 font-semibold text-ink">
              Read the article
            </span>
          </div>
        </div>
      </a>
      <div class="flex flex-col gap-5">
        {more.map((a) => (
          <a
            href={`/learn/${a.id}`}
            class="grid grid-cols-[100px_1fr] gap-5.5 bg-white p-4 transition duration-200 hover:shadow-[0_10px_30px_rgba(0,0,0,0.08)] sm:grid-cols-[150px_1fr]"
          >
            <div class="cover min-h-32.5 bg-[#ddd]">
              {a.data.featured_image && <Image image={a.data.featured_image} />}
            </div>
            <div>
              {topicOf(a) && (
                <div class="text-sm font-bold tracking-[2px] text-brand uppercase">
                  {topicOf(a)}
                </div>
              )}
              <h4 class="mt-1.5 mb-2 font-serif text-[22px] leading-[1.3] font-medium">
                {a.data.title}
              </h4>
              <div class="text-[15px] text-[#666]">
                {readMinutes(a.data.content)} min read
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  ) : (
    <div class="bg-white p-10">No articles in this topic yet.</div>
  )}
  {topic && (
    <p class="mt-10 text-center">
      <a
        href={`/learn?topic=${topic.slug}`}
        class="border-b-2 border-brand pb-0.5 text-lg font-semibold"
      >
        See all {topicTotal(topic)} {topic.label} articles →
      </a>
    </p>
  )}
</div>
