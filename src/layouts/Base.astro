---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import "../styles/global.css";
import { getHomepage, getNextWorkshop, telHref, workshopParts, DEFAULT_TIMEZONE } from "../lib/site";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content } = Astro.props;

const [settingsResult, primary, footerLearn, footerServices, homeResult, workshopResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getMenuWithCacheHint("footer_learn"),
	getMenuWithCacheHint("footer_services"),
	getHomepage(),
	getNextWorkshop(),
]);
if (Astro.cache?.enabled) {
	for (const r of [settingsResult, primary, footerLearn, footerServices, homeResult, workshopResult]) {
		Astro.cache.set(r.cacheHint);
	}
}

const settings = settingsResult.data as { title?: string; tagline?: string; timezone?: string } | undefined;
const siteTitle = settings?.title || "Randyl Homes Group";
const timezone = settings?.timezone || DEFAULT_TIMEZONE;
const fullTitle = title === siteTitle || title.endsWith(` | ${siteTitle}`) ? title : `${title} | ${siteTitle}`;

const home = homeResult.home?.data;
const phone = home?.phone ?? "";
const brokerage = home?.brokerage || "Keller Williams Realty";
const workshop = workshopResult.workshop?.data;
const w = workshop ? workshopParts(workshop.starts_at, workshop.ends_at, timezone) : null;

const path = Astro.url.pathname;
const isActive = (url: string) => url !== "/" && !url.startsWith("/#") && path.startsWith(url.split(/[?#]/)[0]);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: content ? "article" : "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: description ?? settings?.tagline,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,500&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<div class="bg-brand text-[15px] font-medium text-white print:hidden">
			<div class="wrap flex justify-between gap-5 py-[9px]">
				{
					workshop && w ? (
						<span>
							📅 Free Workshop: <b>{workshop.short_title || workshop.title}</b> — {w.weekday}, {w.shortDate} ·{" "}
							<a href="/#workshop" class="underline underline-offset-3">
								Save your seat
							</a>
						</span>
					) : (
						<span>Free, no-pressure guidance for your next move</span>
					)
				}
				<span class="hidden sm:inline">{brokerage}</span>
			</div>
		</div>

		<nav class="sticky top-0 z-30 border-b border-line bg-white shadow-[0_2px_14px_rgba(0,0,0,0.05)] print:hidden" aria-label="Main">
			<div class="wrap flex h-19 items-center justify-between gap-4 sm:h-23 sm:gap-10">
				<a href="/" class="font-serif text-[26px] leading-none sm:text-[30px]">
					Randyl<span class="text-brand">.</span>
					<small class="mt-1.5 block font-sans text-xs tracking-[2px] whitespace-nowrap text-muted uppercase">{brokerage}</small>
				</a>
				<div class="hidden gap-7.5 text-[17px] font-medium whitespace-nowrap lg:flex">
					{
						primary.data?.items.map((item) => (
							<a
								href={item.url}
								target={item.target}
								class:list={["border-b-2 py-1.5 hover:border-brand", isActive(item.url) ? "border-brand" : "border-transparent"]}
							>
								{item.label}
							</a>
						))
					}
				</div>
				<div class="flex items-center gap-5.5">
					{
						phone && (
							<a href={telHref(phone)} class="hidden text-right leading-[1.3] whitespace-nowrap lg:block">
								<small class="block text-[13px] text-muted">Call or text anytime</small>
								<b class="text-xl">{phone}</b>
							</a>
						)
					}
					<a href="/#contact" class="btn btn-red px-4 py-3 text-[15px] sm:px-8 sm:py-4.5 sm:text-[17px]">Free Consultation</a>
				</div>
			</div>
		</nav>

		<main>
			<slot />
		</main>

		<footer class="bg-black pt-20 pb-10 text-base text-[#f5f5f5] print:hidden">
			<div class="wrap">
				<div class="mb-15 grid grid-cols-2 gap-10 sm:grid-cols-[1.4fr_1fr_1fr_1fr]">
					<div>
						<a href="/" class="font-serif text-[26px] leading-none sm:text-[30px]">
							Randyl<span class="text-brand-light">.</span>
							<small class="mt-1.5 block font-sans text-xs tracking-[2px] whitespace-nowrap text-muted-dark uppercase">{brokerage}</small>
						</a>
						{home?.footer_blurb && <p class="mt-5 text-muted-dark">{home.footer_blurb}</p>}
					</div>
					{
						[
							{ heading: "Learn", menu: footerLearn.data },
							{ heading: "Services", menu: footerServices.data },
							{ heading: "Contact", menu: null },
						].map(({ heading, menu }) => (
							<div>
								<h2 class="mb-4.5 text-[15px] font-bold tracking-[2px] text-brand-light uppercase">{heading}</h2>
								<ul class="text-muted-dark [&_a:hover]:text-white [&_li]:mb-2.5">
									{menu?.items.map((item) => (
										<li>
											<a href={item.url} target={item.target}>
												{item.label}
											</a>
										</li>
									))}
									{heading === "Contact" && (
										<>
											{phone && <li><a href={telHref(phone)}>{phone}</a></li>}
											{home?.email && <li><a href={`mailto:${home.email}`}>{home.email}</a></li>}
											{home?.address && <li>{home.address}</li>}
											{home?.hours && <li>{home.hours}</li>}
										</>
									)}
								</ul>
							</div>
						))
					}
				</div>
				<div class="flex flex-col justify-between gap-7.5 border-t border-line-dark pt-6.5 text-sm text-muted-dark sm:flex-row">
					<span>{home?.disclaimer}</span>
					<span>Equal Housing Opportunity</span>
				</div>
			</div>
		</footer>

		<script>
			// Lead forms are not connected to a delivery service yet; acknowledge without sending.
			for (const form of document.querySelectorAll<HTMLFormElement>("form[data-lead]")) {
				form.addEventListener("submit", (event) => {
					event.preventDefault();
					let note = form.querySelector<HTMLElement>(".form-note");
					if (!note) {
						note = document.createElement("p");
						note.className = "form-note mt-2.5 text-[15px] font-semibold text-brand";
						note.setAttribute("role", "status");
						form.append(note);
					}
					note.textContent = "Thanks! (Preview only: this form isn't connected yet.)";
				});
			}
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
