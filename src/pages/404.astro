---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
	<section class="bg-ivory pt-17.5 pb-27.5">
		<div class="wrap">
			<div class="eyebrow">404</div>
			<h1 class="mt-3 mb-4.5 font-serif text-[44px] leading-[1.1] font-medium md:text-[56px]">We couldn't find that page.</h1>
			<p class="lead mb-9">It may have moved. Try the Learning Center, or head back home.</p>
			<div class="flex flex-wrap gap-3.5">
				<a href="/learn" class="btn btn-red">Browse the Learning Center</a>
				<a href="/" class="btn btn-line">Go home</a>
			</div>
		</div>
	</section>
</Base>
