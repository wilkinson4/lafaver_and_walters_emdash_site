---
import { decodeSlug, getEmDashCollection, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import ArticleHeading from "../../components/ArticleHeading.astro";
import ArticleHtmlBlock from "../../components/ArticleHtmlBlock.astro";
import { getHomepage, headings, readMinutes, telHref } from "../../lib/site";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: article, cacheHint } = await getEmDashEntry("posts", slug);
if (!article) return Astro.rewrite("/404");

const [homeResult, recent, settings] = await Promise.all([
	getHomepage(),
	getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 20 }),
	getSiteSettings(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(homeResult.cacheHint);
	Astro.cache.set(recent.cacheHint);
}

const home = homeResult.home?.data;
const data = article.data;
const topics = data.terms?.category ?? [];
const topic = topics[0];
const toc = headings(data.content);
const author = data.byline?.displayName ?? "Randyl";
const updated = (data.updatedAt ?? data.publishedAt)?.toLocaleDateString("en-US", { month: "long", year: "numeric" });

const topicSlugs = new Set(topics.map((t) => t.slug));
const related = recent.entries
	.filter((a) => a.id !== article.id)
	.map((a) => ({ a, score: (a.data.terms?.category ?? []).some((t) => topicSlugs.has(t.slug)) ? 1 : 0 }))
	.sort((x, y) => y.score - x.score)
	.slice(0, 3)
	.map(({ a }) => a);

const seo = getSeoMeta(article, {
	siteTitle: (settings as { title?: string } | undefined)?.title ?? "Randyl Homes Group",
	siteUrl: Astro.url.origin,
	path: `/learn/${slug}`,
});

const toolBtn = "cursor-pointer border border-field px-4 py-2.5 text-[15px] text-ink hover:border-brand hover:text-brand";
const avatar = "cover rounded-full bg-[#ddd] grayscale";
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? data.excerpt}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "posts", id: data.id, slug }}
>
	<div class="article-page bg-ivory [--fs:20px]">
		<header class="bg-white pt-17.5">
			<div class="wrap">
				<div class="mb-6.5 text-[15px] text-muted [&_a]:underline [&_a]:underline-offset-3">
					<a href="/">Home</a> › <a href="/learn">Learning Center</a>
					{topic && <> › <a href={`/learn?topic=${topic.slug}`}>{topic.label}</a></>}
				</div>
				{topic && <div class="eyebrow">{topic.label}</div>}
				<h1 class="mt-4 mb-6 max-w-240 font-serif text-[44px] leading-[1.1] font-medium md:text-[62px]" {...article.edit.title}>{data.title}</h1>
				{data.excerpt && <p class="mb-9 max-w-205 text-[22px] text-muted" {...article.edit.excerpt}>{data.excerpt}</p>}
				<div class="flex flex-wrap items-center gap-7 pb-12.5 text-base text-muted">
					<div class="flex items-center gap-3.5 text-ink">
						<div class:list={[avatar, "size-14"]}>{home?.about_photo && <Image image={home.about_photo} alt="" />}</div>
						<div><b class="block text-[17px]">By {author}</b>{home?.brokerage}</div>
					</div>
					{updated && <span>Updated {updated}</span>}
					<span>·</span>
					<span>{readMinutes(data.content)} min read</span>
					<div class="flex gap-2.5 sm:ml-auto print:hidden" aria-label="Reading tools">
						<button type="button" data-fs="-2" aria-label="Smaller text" class={toolBtn}>A−</button>
						<button type="button" data-fs="2" aria-label="Larger text" class={toolBtn}>A+</button>
						<button type="button" data-print class={toolBtn}>🖨 Print</button>
					</div>
				</div>
			</div>
			{
				data.featured_image && (
					<div class="wrap">
						<div class="cover z-1 -mb-30 h-65 bg-[#ddd] sm:h-120 print:hidden" {...article.edit.featured_image}>
							<Image image={data.featured_image} priority />
						</div>
					</div>
				)
			}
		</header>

		<div
			class:list={[
				"wrap grid gap-17.5 pb-25 md:grid-cols-[1fr_360px] print:block print:pt-5",
				data.featured_image ? "pt-37.5 sm:pt-45" : "pt-17.5",
			]}
		>
			<article>
				<div class="article-body" id="article">
					<PortableText value={data.content} components={{ block: { h2: ArticleHeading }, type: { htmlBlock: ArticleHtmlBlock } }} />
				</div>

				<div
					class="my-[2.2em] grid items-center gap-7.5 border border-t-4 border-line border-t-brand bg-white p-10 shadow-[0_10px_30px_rgba(0,0,0,0.06)] sm:grid-cols-[130px_1fr] print:hidden"
				>
					<div
						class="h-42.5 w-32.5 bg-linear-135 from-[#c10606] to-[#7e0000] px-3.5 py-4.5 font-serif text-lg leading-[1.15] text-white shadow-[10px_10px_30px_rgba(0,0,0,0.5)]"
						aria-hidden="true"
					>
						<small class="mb-2.5 block font-sans text-[9px] tracking-[2px] opacity-85">FREE GUIDE</small>{home?.guide_title ?? "The Rightsizing Playbook"}
					</div>
					<div>
						<div class="eyebrow">Free Download</div>
						<h3 class="mt-1.5 mb-2 font-serif text-[28px] leading-[1.25] font-medium">Get the free {home?.guide_title ?? "guide"}</h3>
						<p class="mb-4.5 text-[17px] leading-[1.6] text-muted">{home?.guide_card_text}</p>
						<form data-lead>
							<div class="flex flex-col gap-2.5 sm:flex-row">
								<input type="email" name="email" required placeholder="Your email address" aria-label="Email address" class="field-input flex-1 px-4 py-[15px]" />
								<button class="btn btn-red px-7 py-4">Send It to Me</button>
							</div>
						</form>
					</div>
				</div>

				<div class="mt-[3em] grid gap-7 bg-white p-8.5 text-lg sm:grid-cols-[110px_1fr]">
					<div class:list={[avatar, "size-27.5"]}>{home?.about_photo && <Image image={home.about_photo} alt="" />}</div>
					<div>
						<h4 class="font-serif text-[26px] font-medium">About {author}</h4>
						<p class="mt-1.5 mb-3.5 leading-[1.7] text-[#444]">{data.byline?.bio ? `${author} · ${data.byline.bio}. ` : ""}{home?.footer_blurb}</p>
						<a href="/#contact" class="border-b-2 border-brand font-semibold">Schedule a free, no-pressure conversation →</a>
					</div>
				</div>
				<p class="mt-[2em] text-[15px] text-[#666] italic">
					This article is for educational purposes only and is not legal, tax, or financial advice. Please consult a qualified
					professional about your specific situation.
				</p>
			</article>

			<aside class="print:hidden">
				<div class="sticky top-30 flex flex-col gap-6.5">
					{
						toc.length > 0 && (
							<nav class="bg-white p-7.5" aria-label="In this article">
								<h2 class="mb-3.5 text-sm font-bold tracking-[2px] text-brand uppercase">In This Article</h2>
								<ol>
									{toc.map((h, i) => (
										<li class="border-t border-[#eee]">
											<a href={`#${h.id}`} class="flex gap-3 py-[11px] text-base leading-[1.4] hover:text-brand">
												<span class="min-w-3.5 font-serif text-brand">{i + 1}</span>
												{h.label}
											</a>
										</li>
									))}
								</ol>
							</nav>
						)
					}
					<form class="border-t-4 border-brand bg-white p-8 shadow-[0_10px_30px_rgba(0,0,0,0.06)]" data-lead>
						<div class="eyebrow">Free · No Obligation</div>
						<h2 class="mt-2 mb-2.5 font-serif text-[26px] leading-[1.25] font-medium">What's your home worth today?</h2>
						<p class="mb-4.5 text-base leading-[1.6] text-muted">Get a personalized home value and net-proceeds estimate from {author}.</p>
						<label for="s-addr" class="field-label">Home address</label>
						<input id="s-addr" name="address" required class="field-input mb-3.5 px-4 py-3.5" />
						<label for="s-email" class="field-label">Email or phone</label>
						<input id="s-email" name="contact" required class="field-input mb-3.5 px-4 py-3.5" />
						<button class="btn btn-red w-full justify-center px-7 py-4">Get My Home Value</button>
						{
							home?.phone && (
								<>
									<div class="mt-3.5 mb-1 text-center text-[15px] text-muted">or call / text</div>
									<a href={telHref(home.phone)} class="block text-center text-[22px] font-bold">
										{home.phone}
									</a>
								</>
							)
						}
					</form>
				</div>
			</aside>
		</div>

		{
			related.length > 0 && (
				<section class="bg-white py-25 print:hidden">
					<div class="wrap">
						<div class="eyebrow">Keep Learning</div>
						<h2 class="mt-2.5 mb-10 font-serif text-[44px] font-medium">Related articles</h2>
						<div class="grid gap-7 sm:grid-cols-2 md:grid-cols-3">
							{related.map((a) => (
								<ArticleCard article={a} />
							))}
						</div>
					</div>
				</section>
			)
		}
	</div>
</Base>

<script>
	const page = document.querySelector<HTMLElement>(".article-page");
	let size = 20;
	for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-fs]")) {
		btn.addEventListener("click", () => {
			size = Math.min(26, Math.max(18, size + Number(btn.dataset.fs)));
			page?.style.setProperty("--fs", `${size}px`);
		});
	}
	document.querySelector("[data-print]")?.addEventListener("click", () => window.print());
</script>
