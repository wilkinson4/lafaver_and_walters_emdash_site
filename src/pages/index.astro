---
import {
  getEmDashCollection,
  getTaxonomyTermsWithCacheHint,
  getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import TopicNav from "../components/TopicNav.astro";
import {
  getHomepage,
  getNextWorkshop,
  emphasis,
  readMinutes,
  telHref,
  workshopParts,
  DEFAULT_TIMEZONE,
} from "../lib/site";

const [
  homeResult,
  workshopResult,
  articlesResult,
  testimonialsResult,
  faqsResult,
  topicsResult,
  settings,
] = await Promise.all([
  getHomepage(),
  getNextWorkshop(),
  getEmDashCollection("posts", {
    orderBy: { published_at: "desc" },
    limit: 12,
  }),
  getEmDashCollection("testimonials", {
    orderBy: { sort_order: "asc" },
    limit: 3,
  }),
  getEmDashCollection("faqs", { orderBy: { sort_order: "asc" }, limit: 12 }),
  getTaxonomyTermsWithCacheHint("category"),
  getSiteSettings(),
]);
if (Astro.cache?.enabled) {
  for (const r of [
    homeResult,
    workshopResult,
    articlesResult,
    testimonialsResult,
    faqsResult,
    topicsResult,
  ]) {
    Astro.cache.set(r.cacheHint);
  }
}

const entry = homeResult.home;
if (!entry) {
  return new Response(
    "Homepage content is missing. Create it in the EmDash admin under Homepage.",
    { status: 503 },
  );
}
const home = entry.data;
const edit = entry.edit;
const timezone =
  (settings as { timezone?: string } | undefined)?.timezone || DEFAULT_TIMEZONE;

const articles = articlesResult.entries;
const featured = articles.find((a) => a.data.featured) ?? articles[0];
const moreArticles = articles.filter((a) => a !== featured).slice(0, 3);
const topicOf = (a: (typeof articles)[number]) =>
  a.data.terms?.category?.[0]?.label;

const workshop = workshopResult.workshop;
const w = workshop
  ? workshopParts(workshop.data.starts_at, workshop.data.ends_at, timezone)
  : null;
const phone = home.phone ?? "";
const quizOptions = [
  "None, we use every room",
  "One or two rooms",
  "Three or more rooms",
  "I'm not sure",
];
const finalBg =
  'linear-gradient(rgba(247,245,242,0.95), rgba(247,245,242,0.97)), url("https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?w=1800&q=80")';
---

<Base
  title={
    home.hero_eyebrow
      ? `Randyl Homes Group | ${home.hero_eyebrow}`
      : "Randyl Homes Group"
  }
>
  <header class="grid min-h-[700px] md:grid-cols-[1.05fr_1fr]">
    <div class="flex flex-col justify-center px-5 py-12.5 sm:px-10 sm:py-17.5 md:py-22.5 md:pr-17.5 md:pl-[max(40px,calc((100vw_-_1280px)/2_+_40px))]">
      <div class="mb-7 h-[3px] w-17.5 bg-brand"></div>
      <div class="eyebrow" {...edit.hero_eyebrow}>
        {home.hero_eyebrow}
      </div>
      <h1
        class="mt-4.5 mb-6.5 font-serif text-[46px] leading-[1.08] font-medium sm:text-[66px]"
        {...edit.hero_headline}
      >
        {emphasis(home.hero_headline).map((s) =>
          s.em ? <em class="text-brand">{s.text}</em> : s.text,
        )}
      </h1>
      <p
        class="mb-10 max-w-[540px] text-[21px] text-muted"
        {...edit.hero_intro}
      >
        {home.hero_intro}
      </p>
      <div class="mb-10 flex flex-wrap gap-4">
        <a href="#guide" class="btn btn-red">
          Get the Free Guide →
        </a>
        <a href="#contact" class="btn btn-line">
          Book a 20-Min Call
        </a>
      </div>
      <div
        class="flex flex-wrap gap-7 text-base text-muted"
        {...edit.trust_points}
      >
        {(home.trust_points ?? []).map((t) => (
          <span>
            {t.show_stars && (
              <span class="tracking-[2px] text-star" aria-label="5 stars">
                ★★★★★{" "}
              </span>
            )}
            {emphasis(t.text).map((s) =>
              s.em ? <b class="text-ink">{s.text}</b> : s.text,
            )}
          </span>
        ))}
      </div>
    </div>
    <div class="relative min-h-[460px] bg-ivory before:absolute before:inset-0 before:z-1 before:bg-linear-to-r before:from-white before:to-transparent before:to-30% md:min-h-0">
      {home.hero_image && (
        <div class="cover absolute inset-0" {...edit.hero_image}>
          <Image image={home.hero_image} priority />
        </div>
      )}
      <div class="absolute right-5 bottom-5 left-5 z-2 border-l-4 border-brand bg-white p-8 shadow-[0_30px_60px_rgba(0,0,0,0.18)] md:right-auto md:bottom-15 md:-left-15 md:w-[420px]">
        <div class="eyebrow text-[13px]">Free Download</div>
        <h3
          class="my-2 font-serif text-[30px] leading-[1.2] font-medium"
          {...edit.guide_title}
        >
          {home.guide_title}
        </h3>
        <p class="mb-5 text-base text-muted" {...edit.guide_card_text}>
          {home.guide_card_text}
        </p>
        <a href="#guide" class="border-b-2 border-brand pb-[3px] font-semibold">
          Send me the free guide →
        </a>
      </div>
    </div>
  </header>

  <section class="border-y border-line bg-ivory" id="paths">
    <div class="wrap flex flex-col items-start justify-between gap-10 pt-12.5 pb-7.5 sm:pt-17.5 sm:pb-10 md:flex-row md:items-end">
      <div>
        <div class="eyebrow">Start here</div>
        <h2 class="section-title mb-0" {...edit.paths_heading}>
          {home.paths_heading}
        </h2>
      </div>
      <p class="lead max-w-[440px]" {...edit.paths_intro}>
        {home.paths_intro}
      </p>
    </div>
    <div class="mx-auto max-w-[1280px] px-10">
      <div
        class="grid border-t border-line sm:grid-cols-2 md:grid-cols-4"
        {...edit.paths}
      >
        {(home.paths ?? []).map((path, i) => (
          <a
            href={path.link_url || "#contact"}
            class="group border-b border-line px-8 pt-10 pb-11 transition duration-250 hover:bg-brand hover:text-white sm:border-r sm:border-b-0 sm:last:border-r-0"
          >
            <div class="font-serif text-xl text-brand group-hover:text-white">
              {String(i + 1).padStart(2, "0")}
            </div>
            <h3 class="mt-3.5 mb-2.5 font-serif text-[27px] leading-[1.25] font-medium">
              {path.title}
            </h3>
            <p class="mb-5.5 text-[17px] text-muted group-hover:text-white">
              {path.description}
            </p>
            {path.link_label && (
              <span class="text-base font-semibold">{path.link_label} →</span>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-30" id="guide">
    <div class="wrap grid items-center gap-12.5 md:grid-cols-[0.9fr_1.1fr] md:gap-22.5">
      <div class="grid place-items-center bg-[radial-gradient(circle_at_50%_50%,#f6e1e1_0%,transparent_70%)] p-10">
        <div
          class="relative h-95 w-70 bg-linear-135 from-[#c10606] to-[#7e0000] px-9.5 py-11.5 text-white shadow-[30px_30px_60px_rgba(0,0,0,0.6),inset_8px_0_0_rgba(0,0,0,0.25)] [transform:perspective(900px)_rotateY(-14deg)] after:absolute after:top-2 after:-right-3.5 after:-bottom-2 after:w-3.5 after:origin-left after:bg-[repeating-linear-gradient(0deg,#eee_0_2px,#ccc_2px_3px)] after:[transform:skewY(-30deg)] sm:h-[450px] sm:w-[340px]"
          aria-hidden="true"
        >
          <small class="text-xs tracking-[4px] uppercase opacity-85">
            Free Homeowner Guide
          </small>
          <h4 class="mt-5.5 mb-4.5 font-serif text-[44px] leading-[1.05] font-medium">
            {home.guide_title}
          </h4>
          <div class="mb-4.5 h-[3px] w-12.5 bg-white"></div>
          <p class="text-[15px] leading-normal opacity-90">
            {home.guide_card_text}
          </p>
          <div class="absolute right-9.5 bottom-9.5 left-9.5 border-t border-white/40 pt-3.5 text-[13px] tracking-[2px] uppercase">
            Randyl Homes · Keller Williams
          </div>
        </div>
      </div>
      <div>
        <div class="eyebrow">Free Guide · Instant Download</div>
        <h2 class="section-title" {...edit.guide_heading}>
          {home.guide_heading}
        </h2>
        <p class="lead" {...edit.guide_intro}>
          {home.guide_intro}
        </p>
        <ul class="mt-6.5 mb-8.5" {...edit.guide_points}>
          {(home.guide_points ?? []).map((pt) => (
            <li class="relative py-[9px] pl-10 text-[19px]">
              <span
                class="absolute top-[11px] left-0 grid size-6.5 place-items-center bg-brand text-sm font-bold text-white"
                aria-hidden="true"
              >
                ✓
              </span>
              {pt.text}
            </li>
          ))}
        </ul>
        <form class="grid gap-3 sm:grid-cols-[1fr_1fr_auto]" data-lead>
          <div>
            <label for="g-name" class="field-label">
              First name
            </label>
            <input
              id="g-name"
              name="name"
              placeholder="Jane"
              class="field-input"
            />
          </div>
          <div>
            <label for="g-email" class="field-label">
              Email address
            </label>
            <input
              id="g-email"
              name="email"
              type="email"
              required
              placeholder="jane@email.com"
              class="field-input"
            />
          </div>
          <button class="btn btn-red h-14.5 self-end">Send My Guide</button>
        </form>
        <p class="mt-3.5 text-[15px] text-muted">
          🔒 We respect your privacy. No spam, unsubscribe anytime.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-ivory py-20 sm:py-30" id="learn">
    <div class="wrap">
      <div class="mb-12.5 flex flex-col items-start justify-between gap-10 md:flex-row md:items-end">
        <div>
          <div class="eyebrow">The Learning Center</div>
          <h2 class="section-title mb-2.5" {...edit.learn_heading}>
            {home.learn_heading}
          </h2>
        </div>
        <a href="/learn" class="btn btn-black">
          Browse All Articles →
        </a>
      </div>
      <TopicNav topics={topicsResult.data} />
      {featured ? (
        <div class="grid gap-10 md:grid-cols-[1.25fr_1fr]">
          <a href={`/learn/${featured.id}`} class="flex flex-col bg-white">
            <div class="cover h-85 bg-[#ddd]">
              {featured.data.featured_image && (
                <Image image={featured.data.featured_image} />
              )}
            </div>
            <div class="p-9">
              {topicOf(featured) && (
                <div class="text-sm font-bold tracking-[2px] text-brand uppercase">
                  {topicOf(featured)}
                </div>
              )}
              <h3 class="mt-2.5 mb-3.5 font-serif text-[34px] leading-[1.2] font-medium">
                {featured.data.title}
              </h3>
              <p class="mb-5 text-muted">{featured.data.excerpt}</p>
              <div class="flex gap-4.5 text-[15px] text-[#666]">
                <span>{readMinutes(featured.data.content)} min read</span>
                <span>·</span>
                <span class="border-b-2 border-brand pb-0.5 font-semibold text-ink">
                  Read the article
                </span>
              </div>
            </div>
          </a>
          <div class="flex flex-col gap-5">
            {moreArticles.map((a) => (
              <a
                href={`/learn/${a.id}`}
                class="grid grid-cols-[100px_1fr] gap-5.5 bg-white p-4 transition duration-200 hover:shadow-[0_10px_30px_rgba(0,0,0,0.08)] sm:grid-cols-[150px_1fr]"
              >
                <div class="cover min-h-32.5 bg-[#ddd]">
                  {a.data.featured_image && (
                    <Image image={a.data.featured_image} />
                  )}
                </div>
                <div>
                  {topicOf(a) && (
                    <div class="text-sm font-bold tracking-[2px] text-brand uppercase">
                      {topicOf(a)}
                    </div>
                  )}
                  <h4 class="mt-1.5 mb-2 font-serif text-[22px] leading-[1.3] font-medium">
                    {a.data.title}
                  </h4>
                  <div class="text-[15px] text-[#666]">
                    {readMinutes(a.data.content)} min read
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      ) : (
        <div class="bg-white p-10">No articles published yet.</div>
      )}
    </div>
  </section>

  {(home.stats ?? []).length > 0 && (
    <div class="border-y border-line py-20">
      <div
        class="wrap grid gap-7.5 sm:grid-cols-2 sm:gap-0 md:grid-cols-4"
        {...edit.stats}
      >
        {(home.stats ?? []).map((s) => (
          <div class="border-l-2 border-brand px-7.5">
            <b class="block font-serif text-[52px] leading-[1.1] font-medium">
              {s.value}
            </b>
            <p class="mt-1.5 text-[17px] text-muted">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  )}

  {workshop && w && (
    <section class="py-20 sm:py-30" id="workshop">
      <div class="mx-auto grid max-w-[1280px] border border-line bg-ivory shadow-[0_20px_50px_rgba(0,0,0,0.06)] md:grid-cols-2">
        <div
          class="cover min-h-80 bg-[#ddd] md:min-h-[520px]"
          {...workshop.edit.image}
        >
          {workshop.data.image && <Image image={workshop.data.image} />}
        </div>
        <div class="p-7.5 sm:p-16">
          <div class="eyebrow">Free Live Workshop</div>
          <h2 class="section-title" {...workshop.edit.title}>
            {workshop.data.title}
          </h2>
          <p class="lead" {...workshop.edit.summary}>
            {workshop.data.summary}
          </p>
          <div class="my-7.5 grid grid-cols-[auto_1fr] items-center gap-6.5 border-y border-line py-6">
            <div class="bg-brand px-5.5 py-3.5 text-center text-white">
              <small class="block text-sm font-bold tracking-[2px]">
                {w.month}
              </small>
              <b class="font-serif text-[44px] leading-none font-medium">
                {w.day}
              </b>
            </div>
            <p class="text-[17px] text-muted">
              <strong class="text-[19px] text-ink">
                {w.weekday}, {w.timeRange}
              </strong>
              <br />
              <span {...workshop.edit.location}>{workshop.data.location}</span>
            </p>
          </div>
          <a href={workshop.data.rsvp_url || "#contact"} class="btn btn-red">
            Reserve My Free Seat
          </a>
          {(workshop.data.capacity || workshop.data.seats_left != null) && (
            <p class="mt-4 text-base text-muted">
              {workshop.data.capacity && (
                <>Limited to {workshop.data.capacity} guests · </>
              )}
              {workshop.data.seats_left != null && (
                <b class="text-brand">{workshop.data.seats_left} seats left</b>
              )}
            </p>
          )}
        </div>
      </div>
    </section>
  )}

  <section
    class:list={["pb-20 sm:pb-30", { "pt-20 sm:pt-30": !workshop }]}
    id="quiz"
  >
    <div class="wrap grid items-center gap-12.5 md:grid-cols-2 md:gap-20">
      <div>
        <div class="eyebrow">2-Minute Self-Assessment</div>
        <h2 class="section-title" {...edit.quiz_heading}>
          {home.quiz_heading}
        </h2>
        <p class="lead mb-8.5" {...edit.quiz_intro}>
          {home.quiz_intro}
        </p>
        <a href="#contact" class="btn btn-red">
          Take the Quiz →
        </a>
      </div>
      <div
        class="border border-line bg-white p-7.5 shadow-[0_24px_60px_rgba(0,0,0,0.1)] sm:p-11"
        aria-label="Sample quiz question"
      >
        <div class="mb-6.5 h-1.5 bg-[#eee]">
          <i class="block h-full w-[30%] bg-brand"></i>
        </div>
        <div class="text-[15px] font-semibold text-[#666]">Question 3 of 8</div>
        <h4 class="mt-2 mb-6 font-serif text-[28px] leading-[1.3] font-medium">
          How many rooms in your home go unused most of the year?
        </h4>
        {quizOptions.map((opt, i) => (
          <label class="mb-3 flex cursor-pointer items-center gap-4 border-2 border-[#ddd] px-5 py-4.5 text-lg transition duration-150 hover:border-brand has-checked:border-brand has-checked:bg-[#fdf2f2]">
            <input
              type="radio"
              name="q"
              checked={i === 1}
              class="size-5.5 accent-brand"
            />{" "}
            {opt}
          </label>
        ))}
      </div>
    </div>
  </section>

  {testimonialsResult.entries.length > 0 && (
    <section class="bg-ivory py-20 sm:py-30">
      <div class="wrap">
        <div class="mb-15 text-center">
          <div class="eyebrow">In Their Words</div>
          <h2 class="section-title" {...edit.reviews_heading}>
            {home.reviews_heading}
          </h2>
        </div>
        <div class="grid gap-7 md:grid-cols-3">
          {testimonialsResult.entries.map((t) => (
            <div class="flex flex-col border-t-3 border-brand bg-white px-9 py-10 shadow-[0_8px_30px_rgba(0,0,0,0.05)]">
              <span class="tracking-[2px] text-star" aria-label="5 stars">
                ★★★★★
              </span>
              <blockquote
                class="mt-4.5 mb-7.5 flex-1 font-serif text-[22px] leading-[1.55] italic"
                {...t.edit.quote}
              >
                "{t.data.quote}"
              </blockquote>
              <div class="flex items-center gap-4">
                <div class="cover size-15 flex-none rounded-full bg-[#ddd]">
                  {t.data.photo && <Image image={t.data.photo} alt="" />}
                </div>
                <div>
                  <b class="block text-lg" {...t.edit.name}>
                    {t.data.name}
                  </b>
                  <small class="text-[15px] text-muted" {...t.edit.detail}>
                    {t.data.detail}
                  </small>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="grid md:grid-cols-2" id="about">
    <div
      class="cover min-h-[420px] bg-[#ccc] grayscale md:min-h-[600px] [&_img]:object-[center_20%]"
      {...edit.about_photo}
    >
      {home.about_photo && <Image image={home.about_photo} />}
    </div>
    <div class="flex flex-col justify-center bg-brand px-10 py-15 text-white md:px-20 md:py-22.5">
      <div class="eyebrow text-white opacity-85">Meet Randyl</div>
      <h2
        class="mt-3.5 mb-6 font-serif text-[50px] leading-[1.15] font-medium"
        {...edit.about_heading}
      >
        {home.about_heading}
      </h2>
      <div class="[&_p]:mb-4.5 [&_p]:text-[19px]">
        <PortableText value={home.about_body} />
      </div>
      <div class="mt-2.5 mb-8.5 font-serif text-[26px] italic">— Randyl</div>
      <div class="flex flex-wrap gap-3.5">
        <a href="#contact" class="btn btn-black">
          Schedule a Free Call
        </a>
        {phone && (
          <a href={telHref(phone)} class="btn btn-white">
            📞 {phone}
          </a>
        )}
      </div>
    </div>
  </div>

  {faqsResult.entries.length > 0 && (
    <section class="py-20 sm:py-30">
      <div class="wrap grid gap-12.5 md:grid-cols-[0.8fr_1.2fr] md:gap-20">
        <div>
          <div class="eyebrow">Common Questions</div>
          <h2 class="section-title" {...edit.faq_heading}>
            {home.faq_heading}
          </h2>
          <p class="lead" {...edit.faq_intro}>
            {home.faq_intro}
          </p>
        </div>
        <div>
          {faqsResult.entries.map((f, i) => (
            <details open={i === 0} class="group border-b border-line">
              <summary
                class="relative cursor-pointer list-none py-7 pr-12.5 font-serif text-2xl after:absolute after:top-5.5 after:right-0 after:font-sans after:text-[32px] after:font-light after:text-brand after:content-['+'] group-open:after:content-['−'] [&::-webkit-details-marker]:hidden"
                {...f.edit.question}
              >
                {f.data.question}
              </summary>
              <p class="pr-12.5 pb-7 text-lg text-muted" {...f.edit.answer}>
                {f.data.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section
    class="bg-cover bg-center py-20 sm:py-30"
    style={{ backgroundImage: finalBg }}
    id="contact"
  >
    <div class="wrap grid items-center gap-12.5 md:grid-cols-2 md:gap-20">
      <div>
        <div class="eyebrow">Let's Talk</div>
        <h2 class="section-title" {...edit.contact_heading}>
          {home.contact_heading}
        </h2>
        <p class="lead" {...edit.contact_intro}>
          {home.contact_intro}
        </p>
        <ol class="mt-7.5" {...edit.contact_steps}>
          {(home.contact_steps ?? []).map((s, i) => (
            <li class="relative border-b border-line py-4.5 pl-17.5">
              <span class="absolute top-4 left-0 grid size-11.5 place-items-center border-2 border-brand font-serif text-[22px]">
                {i + 1}
              </span>
              <b class="block text-[19px]">{s.title}</b>
              <span class="text-[17px] text-muted">{s.detail}</span>
            </li>
          ))}
        </ol>
      </div>
      <form
        class="border-t-4 border-brand bg-white p-7.5 shadow-[0_24px_60px_rgba(0,0,0,0.1)] sm:p-11.5"
        data-lead
      >
        <h3 class="mb-1.5 font-serif text-[32px] font-medium">
          Request a Free Consultation
        </h3>
        <p class="mb-6.5 text-muted">
          We typically respond within one business day.
        </p>
        <div class="mb-4 grid gap-4 sm:grid-cols-2">
          <div class="mb-4">
            <label for="c-name" class="field-label">
              Full name
            </label>
            <input id="c-name" name="name" required class="field-input" />
          </div>
          <div class="mb-4">
            <label for="c-phone" class="field-label">
              Phone
            </label>
            <input id="c-phone" name="phone" type="tel" class="field-input" />
          </div>
        </div>
        <div class="mb-4">
          <label for="c-email" class="field-label">
            Email
          </label>
          <input id="c-email" name="email" type="email" class="field-input" />
        </div>
        <div class="mb-4">
          <label for="c-topic" class="field-label">
            I'm thinking about…
          </label>
          <select id="c-topic" name="topic" class="field-input">
            <option>Downsizing / rightsizing</option>
            <option>Selling a family or inherited home</option>
            <option>Planning for retirement</option>
            <option>Buying my next home</option>
            <option>Just exploring my options</option>
          </select>
        </div>
        <fieldset>
          <legend class="text-[15px] font-semibold">
            Best way to reach me
          </legend>
          <div class="mt-1.5 mb-6 flex gap-5.5 text-[17px]">
            {[
              ["phone", "Phone call"],
              ["text", "Text"],
              ["email", "Email"],
            ].map(([value, label]) => (
              <label>
                <input
                  type="radio"
                  name="pref"
                  value={value}
                  checked={value === "phone"}
                  class="mr-1.5 size-4.5 align-[-3px] accent-brand"
                />
                {label}
              </label>
            ))}
          </div>
        </fieldset>
        <button class="btn btn-red w-full justify-center">
          Request My Free Consultation
        </button>
      </form>
    </div>
  </section>
</Base>
