{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lafaver-walters",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "lafaver-walters" }],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "lafaver-walters-media" },
  ],
  "durable_objects": {
    "bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }],
  },
  "exports": {
    "EmDashRoom": { "type": "durable-object", "storage": "sqlite" },
  },
  "worker_loaders": [{ "binding": "LOADER" }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
}
