  "content": {
    "homepage": [
      {
        "id": "homepage",
        "status": "published",
        "data": {
          "title": "Homepage",
          "phone": "(610) 703-8137",
          "email": "lafaverandwalters@gmail.com",
          "address": "259 Veterans Lane, Doylestown, PA 18901",
          "hours": "",
          "brokerage": "Keller Williams Real Estate",
          "hero_eyebrow": "Real estate guidance for your next chapter",
          "hero_headline": "Make your next move with *clarity*, not pressure.",
          "hero_intro": "Whether you're downsizing, selling a family home, or planning for retirement, get straightforward answers from a local expert, before you ever have to make a decision.",
          "hero_image": {
            "$media": {
              "url": "https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?w=1600&q=80",
              "filename": "hero-living-room.jpg",
              "alt": "A bright, welcoming living room"
            }
          },
          "trust_points": [
            {
              "text": "*5.0* from 24 Google reviews",
              "show_stars": true
            },
            {
              "text": "*20+ years* helping local families",
              "show_stars": false
            }
          ],
          "paths_heading": "Where are you in your journey?",
          "paths_intro": "Choose the situation closest to yours. We'll point you to the right guides, tools, and next steps.",
          "paths": [
            {
              "title": "Thinking about downsizing",
              "description": "The kids are grown and the house feels big. Is it time, and what would it look like?",
              "link_label": "Explore downsizing",
              "link_url": "/learn?topic=right-sizing-your-life"
            },
            {
              "title": "Selling a family or inherited home",
              "description": "Probate, sentimental belongings, siblings, and repairs. We'll walk you through it.",
              "link_label": "See the step-by-step",
              "link_url": "/#sellers"
            },
            {
              "title": "Planning for retirement",
              "description": "Unlock your home equity, compare 55+ communities, or relocate closer to family.",
              "link_label": "Plan your move",
              "link_url": "/learn?topic=next-chapter-planning"
            },
            {
              "title": "Buying your next home",
              "description": "Single-level living, low maintenance, the right location. Buy smart the second time around.",
              "link_label": "Buyer's roadmap",
              "link_url": "/#buyers"
            }
          ],
          "guide_title": "The Rightsizing Playbook",
          "guide_card_text": "9 steps to sell your family home, simplify your life, and move with confidence. 32 pages, plain English.",
          "guide_heading": "Everything we wish every homeowner knew before they sold.",
          "guide_intro": "Written for homeowners 40+ who are weighing their options. No jargon, no sales pitch.",
          "guide_points": [
            {
              "text": "How to know if it's really the right time to sell"
            },
            {
              "text": "What your home is likely worth, and what you'll actually net"
            },
            {
              "text": "A room-by-room plan for sorting decades of belongings"
            },
            {
              "text": "Buy first or sell first? How to avoid moving twice"
            },
            {
              "text": "Common tax and timing questions to ask your advisor"
            }
          ],
          "learn_heading": "Plain-English answers to the questions we hear most.",
          "featured_topics": [
            "Sellers",
            "Right-Sizing Your Life",
            "Local Living",
            "Buyers"
          ],
          "stats": [
            {
              "value": "20+",
              "label": "Years in business"
            },
            {
              "value": "#1",
              "label": "Brokerage in the world"
            },
            {
              "value": "5.0 ★",
              "label": "Average client rating"
            }
          ],
          "quiz_heading": "Is it time to rightsize?",
          "quiz_intro": "Answer 8 quick questions about your home, lifestyle, and goals. You'll get a personalized readiness score and suggested next steps, free.",
          "reviews_heading": "Families who've been where you are",
          "about_heading": "No pressure. Just honest advice from someone who's been there.",
          "about_body": [
            {
              "_type": "block",
              "_key": "k0",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k1",
                  "text": "For over 20 years, I've helped families in our community navigate some of life's biggest transitions. Many of my clients first reach out a year or more before they're ready, and that's exactly how it should be.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k2",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k3",
                  "text": "My job is to help you understand your options, so whatever you decide, you decide with confidence.",
                  "marks": []
                }
              ]
            }
          ],
          "about_photo": {
            "$media": {
              "url": "https://comehometopa.com/wp-content/uploads/2026/06/9a2dd0f1-4e6a-4494-a20a-9cea7c1e807f-e1780317344397.jpg",
              "filename": "9a2dd0f1-4e6a-4494-a20a-9cea7c1e807f-e1780317344397.jpg",
              "alt": "Randyl Walters"
            }
          },
          "faq_heading": "Good questions deserve straight answers.",
          "faq_intro": "Don't see yours? Call or text. We're happy to talk, even if you're years away from moving.",
          "contact_heading": "Get your free home value and a personalized plan.",
          "contact_intro": "A friendly, no-obligation conversation about your goals, your timeline, and your options.",
          "contact_steps": [
