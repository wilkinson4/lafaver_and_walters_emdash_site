		"faqs": [
			{
				"id": "faq-1",
				"status": "published",
				"data": {
					"sort_order": 1,
					"question": "I'm not ready to sell yet. Is it too early to talk?",
					"answer": "Not at all. Most of our clients start a conversation 6–24 months before they move. Planning early gives you more options, better timing, and far less stress."
				}
			},
			{
				"id": "faq-2",
				"status": "published",
				"data": {
					"sort_order": 2,
					"question": "Do I need to buy my next home before selling this one?",
					"answer": "It depends on your finances and comfort level. There are several ways to avoid moving twice, including contingent offers, bridge financing, and rent-backs. We'll walk through each with you."
				}
			},
			{
				"id": "faq-3",
				"status": "published",
				"data": {
					"sort_order": 3,
					"question": "Can you help with sorting, donating, and moving belongings?",
					"answer": "Yes. We work with trusted senior move managers, estate sale companies, and movers. We can coordinate as much or as little as you'd like."
				}
			},
			{
				"id": "faq-4",
				"status": "published",
				"data": {
					"sort_order": 4,
					"question": "What does a consultation cost?",
					"answer": "Nothing. Consultations, home valuations, guides, and workshops are always free, with no obligation."
				}
			}
		],
		"articles": [
			{
				"id": "a-downsize",
				"slug": "downsize-or-stay-put",
				"status": "published",
				"bylines": [
					{
						"byline": "byline-randyl"
					}
				],
				"taxonomies": {
					"topic": [
						"downsizing"
					]
				},
				"data": {
					"title": "Downsize or Stay Put? 7 Questions to Ask Before You Decide",
					"excerpt": "Before you call a moving company or a contractor, sit down with these seven questions. They'll tell you more about your next move than any market report.",
					"featured": true,
					"featured_image": {
						"$media": {
							"url": "https://images.unsplash.com/photo-1556911220-bff31c812dba?w=1600&q=80",
							"filename": "kitchen-table.jpg",
							"alt": "A sunny kitchen with a table set for planning"
						}
					},
					"content": [
						{
							"_type": "block",
							"_key": "k4",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k5",
									"text": "For many homeowners in their 40s, 50s, and 60s, the question comes up gradually. Maybe it's a staircase that feels steeper than it used to, a yard that takes up every Saturday, or rooms that haven't been used since the kids moved out. Whatever prompted it, deciding whether to downsize is as much a lifestyle decision as a financial one.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k6",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k7",
									"text": "There's no universal right answer. But there ",
									"marks": []
								},
								{
									"_type": "span",
									"_key": "k8",
									"text": "are",
									"marks": [
										"strong"
									]
								},
								{
									"_type": "span",
									"_key": "k9",
									"text": " right questions. Here are the seven we walk through with every family we work with.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "ka",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "kb",
									"text": "1. How well does your home fit the life you live today?",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "kc",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "kd",
									"text": "Homes are usually bought for the life we expected to have over the next 10–15 years. Take an honest inventory: Which rooms do you use every week? Which ones mostly hold furniture and memories? Is the layout still convenient, or are you working around it?",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "ke",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "kf",
									"text": "Randyl's tip:",
									"marks": [
										"strong"
									]
								},
								{
									"_type": "span",
									"_key": "kg",
									"text": " Try the \"one-week walk.\" For seven days, jot down every room you actually use. Most families are surprised by how much of their home sits empty.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "kh",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "ki",
									"text": "2. What will your home realistically need in the next 10 years?",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "kj",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "kk",
									"text": "Roofs, HVAC systems, water heaters, and windows all have lifespans. If several big-ticket items are due soon, it's worth weighing whether you'd rather invest in this home or put that money toward one that better suits your next chapter.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "kl",
							"style": "normal",
							"listItem": "bullet",
							"level": 1,
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "km",
									"text": "Roof: typically 20–30 years",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "kn",
							"style": "normal",
							"listItem": "bullet",
							"level": 1,
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "ko",
									"text": "HVAC system: typically 15–20 years",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "kp",
							"style": "normal",
							"listItem": "bullet",
							"level": 1,
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "kq",
									"text": "Water heater: typically 8–12 years",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "kr",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "ks",
									"text": "3. How much equity do you have, and what would you net?",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "kt",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "ku",
									"text": "Many long-time homeowners are sitting on significant equity. Knowing your home's current market value, minus your mortgage balance and selling costs, gives you a clear picture of what you could put toward your next home, retirement, or family.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "kv",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "kw",
									"text": "4. Where do you want to be, and who do you want to be near?",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "kx",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "ky",
									"text": "Proximity to grandchildren, aging parents, doctors, or friends often matters more than square footage. Some clients move across town; others relocate entirely. Start with the people and places that matter most, then look at homes.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "kz",
							"style": "blockquote",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k10",
									"text": "\"The best moves start with the life you want, not the house you're leaving.\"",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k11",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k12",
									"text": "5. What would you do with all of your belongings?",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k13",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k14",
									"text": "For many families, this is the hardest part, emotionally and practically. Decades of furniture, keepsakes, and heirlooms deserve a thoughtful plan. Senior move managers, estate sale companies, and family \"claim days\" can make the process far less overwhelming.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k15",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k16",
									"text": "6. Should you buy first or sell first?",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k17",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k18",
									"text": "Selling first gives you certainty about your budget; buying first avoids a temporary move. Options like contingent offers, bridge loans, and rent-back agreements can help you get the best of both. The right choice depends on your finances and comfort with risk.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k19",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k1a",
									"text": "7. What does \"simpler\" actually mean to you?",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k1b",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k1c",
									"text": "For some, it's single-level living. For others, it's no yard work, a lock-and-leave home for travel, or a community with built-in social life. Define it clearly, and it becomes much easier to recognize the right next home when you see it.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k1d",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k1e",
									"text": "The bottom line",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k1f",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k1g",
									"text": "You don't need to have every answer today. Most of our clients spend months, sometimes years, thinking through these questions. The goal is simply to make your next move on your own terms, with clear information and no pressure.",
									"marks": []
								}
							]
						}
					]
				}
			},
			{
				"id": "a-parents-home",
				"slug": "selling-a-parents-home",
				"status": "published",
				"bylines": [
					{
						"byline": "byline-randyl"
					}
				],
				"taxonomies": {
					"topic": [
						"inherited-homes"
					]
				},
				"data": {
					"title": "Selling a Parent's Home: A Step-by-Step Guide for Families",
					"excerpt": "From paperwork to the last walk-through, here's how families can sell a parent's home with less stress and fewer surprises.",
					"featured_image": {
						"$media": {
							"url": "https://images.unsplash.com/photo-1582063289852-62e3ba2747f8?w=1200&q=80",
							"filename": "family-home.jpg",
							"alt": "A classic family home exterior"
						}
					},
					"content": [
						{
							"_type": "block",
							"_key": "k1h",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k1i",
									"text": "Selling a parent's home is rarely just a real estate transaction. It often comes during a season of grief or caregiving, with siblings, paperwork, and decades of belongings to sort through. A clear sequence of steps makes it far more manageable.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k1j",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k1k",
									"text": "1. Confirm who has authority to sell",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k1l",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k1m",
									"text": "Before anything else, find out who can legally sign. That may be your parent, an agent under a power of attorney, a trustee, or an executor once the estate is opened. An estate attorney can confirm what applies in your situation.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k1n",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k1o",
									"text": "2. Secure and insure the property",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k1p",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k1q",
									"text": "Vacant homes need attention. Check that insurance is still in force, change the locks if needed, and arrange regular visits to collect mail and check for leaks.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k1r",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k1s",
									"text": "3. Sort belongings before you list",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k1t",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k1u",
									"text": "Give family members time to choose keepsakes, then plan for donation, estate sale, and disposal. A senior move manager can coordinate the whole process if you live out of town.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k1v",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k1w",
									"text": "4. Decide on repairs and pricing together",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k1x",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k1y",
									"text": "Agree as a family on how much to invest before listing. Sometimes a light refresh pays off; sometimes selling as-is is the better path. A pricing review should come before any repair decisions.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k1z",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k20",
									"text": "Randyl's tip:",
									"marks": [
										"strong"
									]
								},
								{
									"_type": "span",
									"_key": "k21",
									"text": " Choose one sibling as the point of contact. Decisions move faster, and everyone still gets the same updates.",
									"marks": []
								}
							]
						}
					]
				}
			},
			{
				"id": "a-equity",
				"slug": "how-much-home-equity-do-you-have",
				"status": "published",
				"bylines": [
					{
						"byline": "byline-randyl"
					}
				],
				"taxonomies": {
					"topic": [
						"retirement-equity"
					]
				},
				"data": {
					"title": "How Much Home Equity Do You Really Have? (And How to Use It)",
					"excerpt": "Your equity is more than a number on a statement. Here's how to estimate it, and the most common ways homeowners put it to work.",
					"featured_image": {
						"$media": {
							"url": "https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=1200&q=80",
							"filename": "home-keys.jpg",
							"alt": "Keys and a model house on a table"
						}
					},
					"content": [
						{
							"_type": "block",
							"_key": "k22",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k23",
									"text": "For many long-time homeowners, the house is their largest asset. But the number that matters isn't the price on a listing site; it's what you'd actually walk away with.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k24",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k25",
									"text": "Start with a realistic market value",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k26",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k27",
									"text": "Online estimates are a starting point. A local comparative market analysis looks at recent nearby sales, your home's condition, and current demand.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k28",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k29",
									"text": "Subtract what you owe and what it costs to sell",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k2a",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k2b",
									"text": "Take your estimated value, subtract your remaining mortgage or home equity loan balance, then subtract typical selling costs such as commissions, closing costs, and any repairs or concessions.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k2c",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k2d",
									"text": "Common ways to use your equity",
									"marks": []
								}
