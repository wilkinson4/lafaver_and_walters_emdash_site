    "faqs": [
      {
        "id": "faq-1",
        "status": "published",
        "data": {
          "sort_order": 1,
          "question": "I'm not ready to sell yet. Is it too early to talk?",
          "answer": "Not at all. Most of our clients start a conversation 6–24 months before they move. Planning early gives you more options, better timing, and far less stress."
        }
      },
      {
        "id": "faq-2",
        "status": "published",
        "data": {
          "sort_order": 2,
          "question": "Do I need to buy my next home before selling this one?",
          "answer": "It depends on your finances and comfort level. There are several ways to avoid moving twice, including contingent offers, bridge financing, and rent-backs. We'll walk through each with you."
        }
      },
      {
        "id": "faq-3",
        "status": "published",
        "data": {
          "sort_order": 3,
          "question": "Can you help with sorting, donating, and moving belongings?",
          "answer": "Yes. We work with trusted senior move managers, estate sale companies, and movers. We can coordinate as much or as little as you'd like."
        }
      },
      {
        "id": "faq-4",
        "status": "published",
        "data": {
          "sort_order": 4,
          "question": "What does a consultation cost?",
          "answer": "Nothing. Consultations, home valuations, guides, and workshops are always free, with no obligation."
        }
      }
    ],
    "team": [
      {
        "id": "team-randyl-walters",
        "slug": "randyl-walters",
        "status": "published",
        "data": {
          "name": "Randyl Walters",
          "role": "Realtor®, Partner",
          "credentials": "Mortgage Loan Originator, GRTS",
          "tagline": "Obsessed With Real Estate. Totally Fine Otherwise.",
          "bio": [
            {
              "_type": "block",
              "_key": "170aa72edeb4",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "31e4b226d9a6",
                  "text": "Randyl has been helping Lehigh Valley families buy and sell homes for 24+ years—which is either impressive or concerning, depending on who you ask. As both a licensed realtor and mortgage loan originator, she can walk you through the entire process from “should I do this?” to “wait, I own a house now?”",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "0015f09b8186",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "e419876c7c9c",
                  "text": "Before real estate, she spent her post-Lafayette College years climbing the corporate ladder in sales, marketing, and finance. Turns out she preferred helping people move into their dream homes over quarterly earnings reports. Go figure.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "efdd22263047",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "9afda4a77037",
                  "text": "When she’s not coordinating same-day closings or explaining tax implications, you’ll find her writing, reading science fiction novels (yes, the nerdy ones with dragons), or explaining to Chris why Star Wars is technically fantasy, not sci-fi. He still does not care.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "98e5c47ef02c",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "ce125b133032",
                  "text": "She’s been known to crack dad jokes at closing tables and actually mean them. Her clients describe her as “surprisingly normal for someone who thinks about real estate this much.”",
                  "marks": []
                }
              ]
            }
          ],
          "email": "randylwalters@KW.com",
          "sort_order": 1
        }
      },
      {
        "id": "team-joanna-lafaver",
        "slug": "joanna-lafaver",
        "status": "published",
        "data": {
